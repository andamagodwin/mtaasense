# Copy to backend/.env for local development. Never commit the real file.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS (docker compose up -d db exposes it on 5433)
DATABASE_URL=postgresql+psycopg://mtaasense:mtaasense_dev_only@localhost:5433/mtaasense

# --- Meta Model API (server-side only; never put this in a NEXT_PUBLIC_* variable) ---
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
ANALYSIS_MODEL=muse-spark-1.3
ANALYSIS_REASONING_EFFORT=low
SEGMENTATION_MODEL=sam-3.1
TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
DUPLICATE_MODEL_ASSIST=true
AUTO_SEGMENT_AFTER_ANALYSIS=true

# Hard stop for model spend, estimated from provider usage × official prices.
MODEL_DAILY_BUDGET_USD=5
MODEL_TOTAL_BUDGET_USD=100

# Labeled fixture results for seeded sample reports only (fallback demo mode).
DEMO_FIXTURES_ENABLED=false

# Media (persistent, outside any web root)
MEDIA_STORAGE_PATH=./media

# Security
SECRET_KEY=dev-only-change-me-dev-only-change-me
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# Number of reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
TRUSTED_PROXY_HOPS=0
REPORT_RATE_LIMIT_PER_HOUR=12
