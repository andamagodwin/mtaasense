# Production settings. Copy to deploy/.env.production, fill in, `chmod 600`. Never commit it.

# --- Compose / Caddy ---
API_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org
# Generate: openssl rand -base64 36 | tr -d '/+='
POSTGRES_PASSWORD=

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=true
# The deployed frontend origin(s), comma-separated, e.g. https://mtaasense.vercel.app
CORS_ORIGINS=https://mtaasense.example.org
# Vercel rewrite -> Caddy -> API: the client IP is the 2nd entry from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=2
REPORT_RATE_LIMIT_PER_HOUR=12

# --- Meta Model API (server-side only) ---
MODEL_API_KEY=
ANALYSIS_MODEL=muse-spark-1.3
ANALYSIS_REASONING_EFFORT=low
SEGMENTATION_MODEL=sam-3.1
TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
DUPLICATE_MODEL_ASSIST=true
AUTO_SEGMENT_AFTER_ANALYSIS=true
MODEL_DAILY_BUDGET_USD=5
MODEL_TOTAL_BUDGET_USD=100
DEMO_FIXTURES_ENABLED=false
