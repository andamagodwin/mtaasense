# Public base URL of the MtaaSense API (no trailing slash). Used by next.config.ts rewrites so the
# browser talks to same-origin /api/v1/* and the reviewer session cookie stays first-party.
# Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: MapLibre style URL. Default: OpenFreeMap Positron (free, no key, OSM attribution in style).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
