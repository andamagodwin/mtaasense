{
  "name": "mtaasense-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:vinext": "node scripts/copy-maplibre-worker.mjs && vite dev --port 3001",
    "build:vinext": "node scripts/copy-maplibre-worker.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/copy-maplibre-worker.mjs && vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "1.64.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.26",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module"
}
